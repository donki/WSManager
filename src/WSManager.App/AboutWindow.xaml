<Window x:Class="SocWsManager.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SocWsManager.App.Services"
        Title="{loc:T ActionAbout}"
        Width="560" Height="720" MinWidth="460" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackground}">

    <!--
        «Acerca de» con la estructura canonica del catalogo (como RC Manager): cabecera con logo,
        version y descripcion; novedades; contacto; idioma (con sus banderas, General 6.2);
        privacidad; licencia; y el aviso legal, que va el ultimo.
    -->
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right"
                    ToolTip="{loc:T Close}" AutomationProperties.Name="{loc:T Close}" IsCancel="True" Click="OnCloseClick" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="24,22">
                    <StackPanel>
                        <Image x:Name="LogoImage" Width="84" Height="84" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:T AppTitle}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock x:Name="VersionLabel" Style="{StaticResource HintText}" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Text="{loc:T AboutDescription}" Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="{loc:T Publisher}" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <Button x:Name="NewsButton" Style="{StaticResource OutlineButton}" HorizontalAlignment="Center" Margin="0,14,0,0" Click="OnNewsClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:T ActionWhatsNew}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T Contact}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <Button x:Name="ContactButton" Style="{StaticResource OutlineButton}" HorizontalAlignment="Center" Click="OnContactClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE715;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:T WriteAuthor}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{loc:T ContactHint}" Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T LanguageTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="SpanishButton" Style="{StaticResource OutlineButton}" Click="OnSpanishClick" AutomationProperties.Name="Español">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Bandera de España, plana, 24x16 -->
                                    <Grid Width="24" Height="16" Margin="0,0,8,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="2*" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.Row="0" Fill="{StaticResource FlagRed}" />
                                        <Rectangle Grid.Row="1" Fill="{StaticResource FlagYellow}" />
                                        <Rectangle Grid.Row="2" Fill="{StaticResource FlagRed}" />
                                    </Grid>
                                    <TextBlock Text="Español" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" x:Name="EnglishButton" Style="{StaticResource OutlineButton}" Click="OnEnglishClick" AutomationProperties.Name="English">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Bandera de EE. UU., plana y simplificada, 24x16 -->
                                    <Canvas Width="24" Height="16" Margin="0,0,8,0" ClipToBounds="True">
                                        <Rectangle Width="24" Height="16" Fill="{StaticResource FlagWhite}" />
                                        <Rectangle Canvas.Top="0" Width="24" Height="2" Fill="{StaticResource FlagUsRed}" />
                                        <Rectangle Canvas.Top="4" Width="24" Height="2" Fill="{StaticResource FlagUsRed}" />
                                        <Rectangle Canvas.Top="8" Width="24" Height="2" Fill="{StaticResource FlagUsRed}" />
                                        <Rectangle Canvas.Top="12" Width="24" Height="2" Fill="{StaticResource FlagUsRed}" />
                                        <Rectangle Width="11" Height="8" Fill="{StaticResource FlagUsBlue}" />
                                    </Canvas>
                                    <TextBlock Text="English" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{loc:T LanguageHint}" Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T Privacy}" Style="{StaticResource CardTitle}" Foreground="{DynamicResource Success}" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:T PrivacyText}" Style="{StaticResource HintText}" FontSize="13" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T License}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:T LicenseText}" Style="{StaticResource HintText}" FontSize="13" />
                        <TextBlock Text="{loc:T LicenseLine}" Style="{StaticResource HintText}" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T LegalTitle}" Style="{StaticResource CardTitle}" Foreground="{DynamicResource Danger}" Margin="0,0,0,10" />
                        <Border Background="{DynamicResource WarningSurface}" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="{loc:T LegalText1}" Style="{StaticResource HintText}" FontSize="13" />
                                <TextBlock Text="{loc:T LegalText2}" Style="{StaticResource HintText}" FontSize="13" Margin="0,10,0,0" />
                                <Border Background="{DynamicResource Danger}" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                                    <TextBlock Text="{loc:T WarningText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OnPrimary}"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
