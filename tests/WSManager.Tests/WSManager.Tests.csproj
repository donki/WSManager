<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Banco de pruebas de sOC WSManager (General 8.6): la logica de WSManager.Core. Nada toca HKLM ni
    servicios reales: el registro de prueba va en HKCU\Software\sOCWSManagerTests\<guid> y se borra,
    el SCM es el simulado, y los procesos son el programa de prueba propio (sOCWSManagerTestApp).
    Las pruebas con servicios de verdad solo corren con SOC_WSM_INTEGRATION=1 y elevado.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SocWsManager.Tests</RootNamespace>
    <AssemblyName>WSManager.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WSManager.Core\WSManager.Core.csproj" />
    <!-- Se compilan antes, pero no se enlazan: las pruebas los lanzan como procesos. -->
    <ProjectReference Include="..\WSManager.TestApp\WSManager.TestApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\WSManager.Host\WSManager.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
