<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Programa de prueba propio: hace de «aplicacion» de los servicios en las pruebas (sale con un
    codigo, escribe en stdout/stderr, atiende o ignora Ctrl+C, WM_CLOSE y WM_QUIT, deja hijos...).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>sOCWSManagerTestApp</AssemblyName>
    <RootNamespace>SocWsManager.TestApp</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
