<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de interfaz de sOC WSManager con FlaUI (MIT) sobre UI Automation (General 8.7). Lanzan
    el exe Debug ya compilado en modo aislado (SOC_SANDBOX): SCM y registro simulados en una carpeta
    temporal; nunca se toca un servicio real ni se pide elevacion. Ver README.md de esta carpeta.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SocWsManager.UITests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
